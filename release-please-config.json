{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "extra-files": [
        { "type": "json", "path": "apps/server/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/server/package-lock.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/server/package-lock.json", "jsonpath": "$.packages[\"\"].version" },
        { "type": "json", "path": "apps/web/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/web/package-lock.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/web/package-lock.json", "jsonpath": "$.packages[\"\"].version" }
      ]
    }
  }
}
